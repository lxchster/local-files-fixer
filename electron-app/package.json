{
  "name": "local-files-fixer",
  "productName": "Local Files Toolkit",
  "version": "1.0.0",
  "description": "Finds and fixes hidden problems in .mp3/.m4a files that make Spotify local files grey out or mismatch between devices.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "scan": "node src/cli.js",
    "package": "electron-packager . \"Local Files Toolkit\" --platform=win32 --arch=x64 --out=dist --icon=icon.ico --extra-resource=../tagger.py --overwrite --prune=true --ignore=\"^/dist\"",
    "package:mac": "electron-packager . \"Local Files Toolkit\" --platform=darwin --arch=arm64,x64 --out=dist --icon=icon.icns --extra-resource=../tagger.py --overwrite --prune=true --ignore=\"^/dist\""
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^45.3.3"
  }
}
